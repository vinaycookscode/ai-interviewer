generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYER
  CANDIDATE
  ADMIN
}

enum InterviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// The employer's hiring outcome for a finished interview, separate from InterviewStatus (AIIN-157)
enum HiringDecision {
  UNDECIDED
  SHORTLISTED
  ON_HOLD
  REJECTED
}

// How an interview's proctoring events read, for the employer (AIIN-177)
enum IntegrityVerdict {
  NO_CONCERNS
  WORTH_A_LOOK
  STRONG_CONCERNS
}

// The employer's review of an integrity verdict (AIIN-179)
enum IntegrityReviewOutcome {
  NO_ISSUE
  CONFIRMED
}

enum DecisionSource {
  MANUAL
  BULK
  AUTO_CUTOFF
}

// ============================================
// SUBSCRIPTION SYSTEM ENUMS
// ============================================

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
  TRIALING
}

enum PlanTier {
  FREE
  PRO
  PREMIUM
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(CANDIDATE)
  
  // Location tracking
  country       String?
  countryCode   String?
  city          String?
  latitude      Float?
  longitude     Float?
  ipAddress     String?
  
  // Candidate Identity Documents
  resumeUrl     String?
  resumeName    String?
  panUrl        String?
  panName       String?
  aadhaarUrl    String?
  aadhaarName   String?
  
  features      Json?     // Feature flags for this user (e.g. { "multilingual": true })

  // The Monday report email; off from the unsubscribe link or the profile (AIIN-103)
  weeklyReportEmails Boolean @default(true)
  // An email when an employer moves one of their applications; off until they turn it on (AIIN-197)
  applicationEmails  Boolean @default(false)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Core Relations
  accounts      Account[]
  sessions      Session[]
  jobs          Job[]       @relation("EmployerJobs")
  interviews    Interview[]
  decisionEvents InterviewDecisionEvent[]
  integrityReviews IntegrityReview[] @relation("IntegrityReviews")
  mockInterviews MockInterview[]
  bankItems     BankItem[]
  shortlistShares ShortlistShare[] @relation("ShortlistShares")
  // Talent Match applications (AIIN-195)
  candidateApplications Application[]      @relation("CandidateApplications")
  employerApplications  Application[]      @relation("EmployerApplications")
  applicationEvents     ApplicationEvent[] @relation("ApplicationEvents")
  // Employers a candidate has blocked, and candidates who blocked an employer (AIIN-198)
  blockedEmployers      CandidateBlock[]   @relation("BlockedBy")
  blockedByCandidates   CandidateBlock[]   @relation("BlockedEmployer")
  prepSets      PrepSet[]

  // Placement Platform Relations
  candidateProfile CandidateProfile?
  programEnrollments ProgramEnrollment[]
  squadMemberships   SquadMember[]
  mentorProfile      MentorProfile?
  mentorships        Mentorship[]  @relation("MenteeRelation")
  jobOffers          JobOffer[]
  companySolutions   UserCompanySolution[]
  weeklyReports      WeeklyReport[]
  activityDays       ActivityDay[]
  challengeAnswers   DailyChallengeAnswer[]
  achievements       UserAchievement[]
  coachConversations CoachConversation[]
  codeRuns           CodeRun[]
  certificates       Certificate[]
  
  // Subscription
  subscription       Subscription?
}

// A day the candidate did something that keeps their streak: a plan task or the daily challenge (AIIN-99).
// One streak for the whole app is counted from these, in IST days.
model ActivityDay {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The IST calendar day
  day    DateTime @db.Date

  @@id([userId, day])
}

// A candidate's answer to the daily challenge: one per IST day (AIIN-99)
model DailyChallengeAnswer {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  day        DateTime        @db.Date
  track      String
  questionId String
  question   CompanyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     String          @db.Text
  // 1 to 10 from U; null until graded (grading is retried if Gemini was busy)
  score      Int?
  feedback   String?         @db.Text
  createdAt  DateTime        @default(now())

  @@unique([userId, day])
}

// One row per weekly report email sent, so a week is never sent twice (AIIN-103)
// A badge the candidate earned, kept for good even after the streak behind it ends (AIIN-102).
// The rules are in lib/achievements/rules.ts; seenAt is set once the "New badge" toast has shown.
model UserAchievement {
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key      String
  earnedAt DateTime @default(now())
  seenAt   DateTime?

  @@id([userId, key])
}

// The certificate for finishing the 90-day plan (AIIN-102), public at /certificate/[id].
// The id is the verification code. Name and plan are copied at issue, so it never changes afterwards.
model Certificate {
  id           String            @id
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollmentId String            @unique
  enrollment   ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  name         String
  planName     String
  issuedAt     DateTime          @default(now())

  @@index([userId])
}

// A chat with Ask U, the coach (AIIN-100). Deleting it deletes its messages.
model CoachConversation {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  messages  CoachMessage[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId, updatedAt])
}

// One message: from the candidate ("user") or from U ("model"). A user message with no reply after it
// is one U couldn't answer, kept so it can be tried again.
model CoachMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String            @db.Text
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}

// One run of someone's code on the judge (AIIN-105): for the rate limit and the logs. Never the code itself.
model CodeRun {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String   // practice, interview, check
  language   String
  status     String
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model WeeklyReport {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Monday of the reported week (IST)
  weekStart DateTime @db.Date
  // "active" or "quiet"
  kind      String
  sentAt    DateTime @default(now())

  @@unique([userId, weekStart])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model Job {
  id          String @id @default(uuid())
  title       String
  description String
  employerId  String
  employer    User   @relation("EmployerJobs", fields: [employerId], references: [id])

  // Document requirements
  requireResume Boolean @default(false)
  requireAadhar Boolean @default(false)
  requirePAN    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Set instead of deleting once a job has interviews, so candidates' history is kept (AIIN-188)
  archivedAt DateTime?

  // Talent Match requirements (AIIN-192): proposed by AI, confirmed by the employer. OPEN needs a confirmed must-have.
  status                  JobStatus @default(DRAFT)
  mustHaveSkills          String[]  @default([])
  niceToHaveSkills        String[]  @default([])
  minYears                Int?
  maxYears                Int?
  location                String?
  workMode                WorkMode?
  salaryMin               Int? // rupees a year
  salaryMax               Int?
  maxNoticeDays           Int?
  requirementsConfirmedAt DateTime?
  // The confirmed requirements' meaning, for matching (AIIN-194): gemini-embedding-001 at 768 dimensions
  embedding               Unsupported("vector(768)")?

  questions  Question[]
  interviews Interview[]

  shares     ShortlistShare[]
  applications Application[]
  matches    JobMatch[]
  drives     Drive[]
  @@index([employerId])
  @@index([status])
}

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum QuestionType {
  TEXT
  CODE
}

// A read-only link to a job's shortlist for a hiring manager without an account (AIIN-161). Only the token's hash is kept.
model ShortlistShare {
  id            String    @id @default(cuid())
  jobId         String
  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User      @relation("ShortlistShares", fields: [createdById], references: [id], onDelete: Cascade)
  // SHA-256 of the 256-bit token in the link; the token itself is shown once and never stored
  tokenHash     String    @unique
  // Who it's for, e.g. "Anita, engineering"
  label         String
  // Shortlisted only, or shortlisted and on hold
  includeOnHold Boolean   @default(false)
  expiresAt     DateTime
  revokedAt     DateTime?
  lastOpenedAt  DateTime?
  openCount     Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([jobId])
}

model Question {
  id        String       @id @default(uuid())
  text      String
  type      QuestionType @default(TEXT)
  jobId     String
  job       Job          @relation(fields: [jobId], references: [id])
  createdAt DateTime     @default(now())
  archived  Boolean      @default(false)

  answers Answer[]
}

model Interview {
  id          String          @id @default(uuid())
  candidateId String
  candidate   User            @relation(fields: [candidateId], references: [id])
  jobId       String
  job         Job             @relation(fields: [jobId], references: [id])
  status      InterviewStatus @default(PENDING)
  token       String?         @unique // For secure access

  // Scheduling
  scheduledTime DateTime? // When the interview is scheduled
  expiresAt     DateTime? // When the interview link expires

  // Document uploads
  resumeUrl         String?
  aadhaarUrl        String?
  panUrl            String?
  documentsVerified Boolean @default(false)

  // Results
  score     Float? // Overall score
  feedback  String? // Overall feedback
  language  String   @default("en") // Interview language (en, hi, mr, etc.)
  createdAt DateTime @default(now())

  // When the candidate first started; the integrity timeline counts from here (AIIN-177)
  startedAt   DateTime?
  // When the candidate finished; ranks ties on the candidate list (AIIN-158)
  completedAt DateTime?

  // Integrity verdict from the proctoring events, computed on completion (AIIN-177; rules in lib/integrity/verdict.ts)
  integrityVerdict      IntegrityVerdict?
  integrityReasons      Json?
  integrityComputedAt   DateTime?
  integrityRulesVersion Int?

  // The latest employer review of the verdict, for lists; history in IntegrityReview (AIIN-179)
  integrityReviewOutcome IntegrityReviewOutcome?

  // The candidate said no to the integrity checks (AIIN-176); cleared if they agree later. Consent itself is InterviewConsent.
  consentDeclinedAt DateTime?

  // Hiring decision (AIIN-157); history in InterviewDecisionEvent
  decision     HiringDecision @default(UNDECIDED)
  decisionAt   DateTime?
  decisionById String?

  answers Answer[]
  decisionEvents InterviewDecisionEvent[]
  // The hiring drive this interview belongs to (AIIN-165); its link expires when the drive closes
  driveId String?
  drive   Drive?  @relation(fields: [driveId], references: [id], onDelete: SetNull)
  personalityProfile PersonalityProfile?
  proctoringEvents ProctoringEvent[]
  consents InterviewConsent[]
  integrityReviews IntegrityReview[]
  prepSets PrepSet[]

  @@index([candidateId])
  @@index([jobId])
  @@index([jobId, score])
  @@index([jobId, integrityVerdict])
  @@index([driveId])
  @@index([scheduledTime])
  @@index([status])
}

model Answer {
  id          String    @id @default(uuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id])
  questionId  String
  question    Question  @relation(fields: [questionId], references: [id])
  transcript  String // The text of the answer
  audioUrl    String? // Optional: link to audio file
  videoUrl    String? // Optional: link to video file
  score       Float? // Score for this specific answer
  feedback    String? // Feedback for this specific answer
  createdAt   DateTime  @default(now())
  // Graded by a worker, never inside the candidate's request (AIIN-170); see lib/grading-queue.ts
  gradingStatus   GradingStatus @default(PENDING)
  gradingAttempts Int           @default(0)
  gradeAfter      DateTime      @default(now())
  gradingError    String?

  @@index([gradingStatus, gradeAfter])
  @@index([interviewId, gradingStatus])
}

enum GradingStatus {
  PENDING
  GRADING
  DONE
  FAILED
}

model DailyStat {
  id        String   @id @default(uuid())
  date      DateTime @unique
  visitors  Int      @default(0)
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VisitorLocation {
  id          String   @id @default(uuid())
  country     String
  countryCode String
  city        String?
  latitude    Float?
  longitude   Float?
  visits      Int      @default(1)
  lastVisit   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([countryCode])
}

model MockInterview {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  // Practice settings
  role        String   // e.g., "Frontend Developer"
  difficulty  String   // "Junior", "Mid", "Senior"
  // Written once on the first visit and kept, so a refresh shows the same questions (AIIN-47)
  questions   String[] @default([])
  // For each question, the CompanyQuestion it came from, or "" when Gemini wrote it (AIIN-208)
  bankQuestionIds String[] @default([])
  // What the questions should cover, if given (a plan checkpoint's topics)
  topics      String[] @default([])

  // A 90-day plan checkpoint on day 30, 60 or 90: one per plan and day (AIIN-101)
  enrollmentId  String?
  enrollment    ProgramEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  checkpointDay Int?
  
  // Results
  score       Float?
  feedback    String?
  
  createdAt   DateTime @default(now())
  
  answers     MockAnswer[]

  @@unique([enrollmentId, checkpointDay])
}

model MockAnswer {
  id              String        @id @default(uuid())
  mockInterviewId String
  mockInterview   MockInterview @relation(fields: [mockInterviewId], references: [id])
  // The bank question this answers, when it came from the bank: graded against its model answer (AIIN-208)
  companyQuestionId String?
  companyQuestion   CompanyQuestion? @relation(fields: [companyQuestionId], references: [id], onDelete: SetNull)
  bankItems         BankItem[]

  question        String        // Store question text directly as it's dynamic
  transcript      String
  audioUrl        String?
  score           Float?
  feedback        String?
  
  createdAt       DateTime      @default(now())
}

model PersonalityProfile {
  id                 String    @id @default(uuid())
  interviewId        String    @unique
  interview          Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  
  // Core Traits
  communicationStyle String    // e.g., "Concise", "Elaborate", "Technical"
  confidenceScore    Float     // 0-10
  technicalDepth     String    // "Surface", "Intermediate", "Expert"
  
  // Detailed Analysis
  strengths          String[]
  weaknesses         String[]
  cultureFitScore    Float     // 0-100
  
  summary            String    @db.Text
  
  createdAt          DateTime  @default(now())
}

model RateLimit {
  id          String   @id @default(uuid())
  identifier  String   // IP address or email
  count       Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  
  @@unique([identifier])
}

// Two or three ways to solve a coding problem, shown after a submit (AIIN-221). Written by Gemini, then run against every
// test; code is kept only for the languages that passed them all. testsHash is the tests they passed: stale when they change.
model ProblemSolution {
  id              String          @id @default(cuid())
  questionId      String
  question        CompanyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position        Int
  name            String
  timeComplexity  String
  spaceComplexity String
  explanation     String          @db.Text
  // { javascript?, python?, java?, cpp? }: only languages that passed every test
  code            Json
  testsHash       String
  createdAt       DateTime        @default(now())

  @@index([questionId, position])
}

// An employer's review of an interview's integrity verdict (AIIN-179). Every review is kept; the latest is current
// and copied to Interview.integrityReviewOutcome. reasonCodes snapshots the rules that fired, to tune thresholds.
model IntegrityReview {
  id          String                 @id @default(cuid())
  interviewId String
  interview   Interview              @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  outcome     IntegrityReviewOutcome
  // Required for CONFIRMED; only the employer's team sees it, never the candidate
  note        String?                @db.Text
  verdict     IntegrityVerdict
  reasonCodes String[]
  byUserId    String?
  byUser      User?                  @relation("IntegrityReviews", fields: [byUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime               @default(now())

  @@index([interviewId, createdAt])
}

// Agreement to the integrity checks before an interview (AIIN-176). One row per interview and notice version;
// the notice text is versioned in lib/integrity/notice.ts. The employer sees that and when, never the IP or user agent.
model InterviewConsent {
  id            String    @id @default(uuid())
  interviewId   String
  interview     Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  noticeVersion String
  // The checks the notice listed, e.g. focus, fullscreen, paste, camera
  checks        String[]
  // The language the notice was read in
  language      String
  acceptedAt    DateTime  @default(now())
  ipAddress     String?
  userAgent     String?

  @@unique([interviewId, noticeVersion])
}

model ProctoringEvent {
  id          String   @id @default(uuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id])
  type        String   // "TAB_SWITCH", "WINDOW_BLUR", "FULLSCREEN_EXIT"
  timestamp   DateTime @default(now())
  details     String?  // Optional context

  @@index([interviewId, timestamp])
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(true)
  description String?
  category    String   // "CANDIDATE", "EMPLOYER", "SYSTEM"
  updatedAt   DateTime @updatedAt
}

// ============================================
// CAMPUS PLACEMENT SUCCESS PLATFORM
// ============================================

// --- Placement Program ---
enum TaskType {
  PROBLEM
  VIDEO
  QUIZ
  READING
  MOCK_INTERVIEW
  APTITUDE
  HR_PREP
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  DROPPED
}

model PlacementProgram {
  id           String   @id @default(cuid())
  name         String   // "90-Day Placement Bootcamp"
  slug         String   @unique
  description  String   @db.Text
  durationDays Int      @default(90)
  isActive     Boolean  @default(true)
  // The career path it's built for (sde, qa, data, devops or general); shown first to that role (AIIN-101)
  track        String   @default("general")
  
  modules      ProgramModule[]
  enrollments  ProgramEnrollment[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProgramModule {
  id          String   @id @default(cuid())
  programId   String
  program     PlacementProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  
  dayNumber   Int      // Day 1, 2, 3...
  title       String
  description String?
  content     Json?    // Educational content for the day (concept, takeaways, etc.)
  
  tasks       DailyTask[]
  
  @@unique([programId, dayNumber])
}

model DailyTask {
  id          String   @id @default(cuid())
  moduleId    String
  module      ProgramModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  
  title       String
  type        TaskType
  content     Json     // Flexible content based on type
  duration    Int      // Expected minutes
  order       Int      // Task order within day
  
  // Personalization
  role        String?  // e.g. "Software Developer", "QA" (null = common)
  skills      String[]
  
  completions TaskCompletion[]
}

model ProgramEnrollment {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId     String
  program       PlacementProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  
  startDate     DateTime @default(now())
  currentDay    Int      @default(1)
  status        EnrollmentStatus @default(ACTIVE)
  
  streak        Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveAt  DateTime @default(now())
  
  completions   TaskCompletion[]
  certificate   Certificate?
  checkpoints   MockInterview[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([userId, programId])
}

model TaskCompletion {
  id           String   @id @default(cuid())
  enrollmentId String
  enrollment   ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  taskId       String
  task         DailyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  startedAt    DateTime @default(now())
  completedAt  DateTime?  // null if started but not completed
  score        Float?   // For quizzes/problems
  timeSpent    Int?     // Actual minutes
  metadata     Json?    // Store user answers (e.g. { code: "...", answers: [...] })
  
  @@unique([enrollmentId, taskId])
}

// --- Company Prep Kits ---
model CompanyPrepKit {
  id          String   @id @default(cuid())
  company     String   @unique // "TCS", "Amazon", "Google"
  slug        String   @unique
  logo        String?
  description String   @db.Text
  
  // Interview Process
  rounds      Json     // [{name, type, duration, tips}]
  salaryRange Json?    // {min, max, currency}
  difficulty  String   @default("MEDIUM") // Overall difficulty
  
  // Deep Concepts & Interview Tips
  content     Json?    // {overview, culture, interviewTips, preparationStrategy}
  
  // Content
  questions   CompanyQuestion[]
  resources   CompanyResource[]
  
  // Personalization
  roles       String[] // e.g. ["Software Developer", "QA"]
  skills      String[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CompanyQuestion {
  id          String   @id @default(cuid())
  kitId       String
  kit         CompanyPrepKit @relation(fields: [kitId], references: [id], onDelete: Cascade)
  
  question    String   @db.Text      // Problem title
  description String?  @db.Text      // Detailed problem statement with examples and constraints
  type        String   // "CODING", "APTITUDE", "HR", "GD"
  difficulty  String   // "EASY", "MEDIUM", "HARD"
  frequency   Float    @default(5) // How often asked (1-10)
  year        Int?     // Year reported
  
  answer      String?  @db.Text
  tips        String?
  tags        String[] // Topic tags
  roles       String[] // e.g. ["Software Developer", "QA"]
  
  // Code Editor Support (for CODING type)
  starterCode   String?  @db.Text  // Initial code template
  solutionCode  String?  @db.Text  // Reference solution
  testCases     Json?              // [{input, expected, hidden}]
  language      String?            // javascript, python, java, cpp
  hints         String[] @default([]) // Up to 3, shown one at a time (AIIN-107)

  // Managed in /admin/problems (AIIN-107). Only PUBLISHED reaches candidates; ARCHIVED keeps the solutions saved for it.
  status        String   @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  // The content the reference solution last passed every test with; a coding problem publishes only when it matches
  checkedHash   String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  
  userSolutions UserCompanySolution[]
  challengeAnswers DailyChallengeAnswer[]
  changes     ProblemChange[]

  @@index([status])
  mockAnswers MockAnswer[]
  bestSolutions ProblemSolution[]
  bankItems   BankItem[]
}

enum BankSource {
  MOCK
  INTERVIEW
  COMPANY_PREP
  SELF_ADDED
  RECOMMENDED
}

enum BankStatus {
  NEW
  PRACTISING
  CONFIDENT
}

// A question in a candidate's Question Bank (AIIN-209): one per question, whatever brought it in. Rules in lib/bank/items.ts.
model BankItem {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "cq:<CompanyQuestion id>", "mock:<MockAnswer id>", "self:<uuid>" or "rec:<uuid>" (bankKey), so the same question is never in twice
  sourceKey    String
  source       BankSource
  questionText String     @db.Text
  // The practice role, for a mock question
  topic        String?
  type         String     // HR, TECHNICAL, CODING, APTITUDE
  companyName  String?
  tags         String[]   @default([])
  status       BankStatus @default(NEW)
  // Spaced review (AIIN-212): the box and when it's next due
  box          Int        @default(0)
  nextReview   DateTime?
  notes        String?    @db.Text
  // A model answer Gemini wrote on request for a question the candidate added; always shown as AI-written (AIIN-211)
  aiAnswer     String?    @db.Text
  // The question's meaning, for search (AIIN-210): Gemini gemini-embedding-001 at 768 dimensions, filled on first search
  embedding    Unsupported("vector(768)")?

  companyQuestionId String?
  companyQuestion   CompanyQuestion? @relation(fields: [companyQuestionId], references: [id], onDelete: SetNull)
  // The latest answer, for its score and feedback; deleting the item leaves the answer alone
  mockAnswerId      String?
  mockAnswer        MockAnswer?      @relation(fields: [mockAnswerId], references: [id], onDelete: SetNull)

  attempts     BankAttempt[]
  prepSetItems PrepSetItem[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, sourceKey])
  @@index([userId, status])
  @@index([userId, nextReview])
}

// Fifteen questions picked for one upcoming interview (AIIN-213), built the first time the candidate opens it
model PrepSet {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviewId String
  interview   Interview     @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  // The job's must-have skills, as Gemini read them from the description
  skills      String[]      @default([])
  createdAt   DateTime      @default(now())
  items       PrepSetItem[]

  @@unique([userId, interviewId])
}

model PrepSetItem {
  id          String   @id @default(cuid())
  prepSetId   String
  prepSet     PrepSet  @relation(fields: [prepSetId], references: [id], onDelete: Cascade)
  bankItemId  String
  bankItem    BankItem @relation(fields: [bankItemId], references: [id], onDelete: Cascade)
  // JOB, COMPANY or WEAK: why it was picked
  reason      String
  aiSuggested Boolean  @default(false)
  position    Int

  @@unique([prepSetId, bankItemId])
}

// An answer given from the Question Bank itself (AIIN-212); answers from mock practice stay MockAnswers
model BankAttempt {
  id          String   @id @default(cuid())
  bankItemId  String
  bankItem    BankItem @relation(fields: [bankItemId], references: [id], onDelete: Cascade)
  transcript  String   @db.Text
  score       Float
  feedback    String   @db.Text
  createdAt   DateTime @default(now())

  @@index([bankItemId, createdAt])
}

// Who changed a problem, what and when (AIIN-107). The name is copied, so the history outlives the account.
model ProblemChange {
  id         String          @id @default(cuid())
  questionId String
  question   CompanyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId   String
  authorName String
  summary    String
  createdAt  DateTime        @default(now())

  @@index([questionId, createdAt])
}

model CompanyResource {
  id          String   @id @default(cuid())
  kitId       String
  kit         CompanyPrepKit @relation(fields: [kitId], references: [id], onDelete: Cascade)
  
  title       String
  type        String   // "VIDEO", "ARTICLE", "PDF"
  url         String
  
  createdAt   DateTime @default(now())
}

model UserCompanySolution {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId  String
  question    CompanyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  code        String   @db.Text  // User's solution code
  language    String              // Programming language (javascript, python, java, cpp)
  passedTests Int      @default(0)  // Number of tests that passed
  totalTests  Int      @default(0)  // Total number of tests
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([userId, questionId, language])
  @@index([userId])
  @@index([questionId])
}

// --- Study Squad ---
model StudySquad {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  maxMembers      Int      @default(5)
  isPublic        Boolean  @default(false)
  
  // Target
  targetCompanies String[]
  targetRole      String?
  
  members         SquadMember[]
  activities      SquadActivity[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SquadMember {
  id             String   @id @default(cuid())
  squadId        String
  squad          StudySquad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  role           String   @default("MEMBER") // "LEADER", "MEMBER"
  joinedAt       DateTime @default(now())
  
  // Stats
  problemsSolved Int      @default(0)
  daysActive     Int      @default(0)
  totalPoints    Int      @default(0)
  
  @@unique([squadId, userId])
}

model SquadActivity {
  id          String   @id @default(cuid())
  squadId     String
  squad       StudySquad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  userId      String
  
  type        String   // "PROBLEM_SOLVED", "TASK_COMPLETED", "CHECK_IN"
  description String
  points      Int      @default(0)
  
  createdAt   DateTime @default(now())
}

// --- Mentor Matching ---
model MentorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  company     String   // Current company
  role        String   // Current role
  experience  Int      // Years of experience
  college     String?  // Alma mater
  gradYear    Int?     // Graduation year
  
  bio         String?  @db.Text
  linkedin    String?
  
  // Availability
  isAvailable Boolean  @default(true)
  maxMentees  Int      @default(3)
  
  // Expertise
  skills      String[]
  companies   String[] // Companies they can mentor for
  
  mentorships Mentorship[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Mentorship {
  id          String   @id @default(cuid())
  mentorId    String
  mentor      MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  menteeId    String
  mentee      User     @relation("MenteeRelation", fields: [menteeId], references: [id], onDelete: Cascade)
  
  status      String   @default("PENDING") // "PENDING", "ACTIVE", "COMPLETED", "REJECTED"
  startDate   DateTime?
  endDate     DateTime?
  
  // Sessions
  sessions    MentorSession[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([mentorId, menteeId])
}

model MentorSession {
  id           String   @id @default(cuid())
  mentorshipId String
  mentorship   Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  
  scheduledAt  DateTime
  duration     Int      @default(30) // minutes
  topic        String?
  notes        String?  @db.Text
  completed    Boolean  @default(false)
  
  createdAt    DateTime @default(now())
}

// --- Job Offers ---
model JobOffer {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  company     String
  role        String
  location    String
  
  // Compensation
  baseSalary  Float
  bonus       Float?
  stocks      Float?
  otherBenefits Json?  // {insurance, wfh, etc}
  
  // Details
  joiningDate DateTime?
  offerDate   DateTime @default(now())
  deadline    DateTime?
  
  // Documents
  offerLetterUrl String?  // Uploaded offer letter PDF
  
  status      String   @default("PENDING") // "PENDING", "ACCEPTED", "REJECTED", "NEGOTIATING"
  
  notes       String?  @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- User Feedback ---
model Feedback {
  id          String   @id @default(cuid())
  userId      String?
  userEmail   String?
  userName    String?
  
  content     String   @db.Text
  page        String?  // URL/route where feedback was submitted
  category    String   @default("GENERAL") // GENERAL, BUG, FEATURE, IMPROVEMENT
  
  status      String   @default("NEW") // NEW, REVIEWED, RESOLVED, DISMISSED
  adminNotes  String?  @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// FLASHCARDS SYSTEM
// ============================================

model FlashcardDeck {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   // DSA, System Design, Behavioral, SQL, Custom
  isPublic    Boolean  @default(false)
  userId      String?  // null = system deck
  
  cards       Flashcard[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Flashcard {
  id       String   @id @default(cuid())
  deckId   String
  front    String   @db.Text
  back     String   @db.Text
  
  deck     FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  progress FlashcardProgress[]
  
  createdAt DateTime @default(now())
}

model FlashcardProgress {
  id         String   @id @default(cuid())
  userId     String
  cardId     String
  
  box        Int      @default(1)  // Leitner box 1-5
  nextReview DateTime @default(now())
  lastReview DateTime?
  correctCount Int    @default(0)
  incorrectCount Int  @default(0)
  
  card       Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@unique([userId, cardId])
  @@index([userId])
  @@index([nextReview])
}

model CandidateProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  primaryRole     String?  // e.g., "Fullstack Developer", "Automation Tester"
  experienceLevel String?  // e.g., "Student", "Fresh Graduate", "Junior (1-2y)", "Senior (3y+)"
  skills          String[]
  targetCompanies String[]
  careerGoals     String?  @db.Text
  
  onboardingComplete Boolean @default(false)

  // Resume facts for Talent Match (AIIN-193). Only `resumeFacts` (confirmed by the candidate) is ever shown or matched;
  // `proposedFacts` waits for them. Never name, email or phone.
  city             String?
  noticePeriodDays Int?
  totalYears       Float?
  phone            String?
  resumeText       String?   @db.Text
  resumeReadAt     DateTime? // when the current resume was read, text or not
  proposedFacts    Json?
  resumeFacts      Json?
  factsConfirmedAt DateTime?
  // "Let employers find me" (AIIN-198): off for everyone until they turn it on
  matches           JobMatch[]
  discoverable      Boolean   @default(false)
  discoverableSince DateTime?
  // Confirmed facts and the resume, with personal details removed, for matching (AIIN-194)
  embedding        Unsupported("vector(768)")?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================
// SUBSCRIPTION SYSTEM
// ============================================

model SubscriptionPlan {
  id              String        @id @default(cuid())
  name            String        // "Free", "Pro", "Premium"
  tier            PlanTier      @unique
  
  // Pricing in paise (₹249 = 24900 paise)
  monthlyPrice    Int           @default(0)
  yearlyPrice     Int           @default(0)
  
  // Feature limits (-1 = unlimited)
  mockInterviewLimit      Int   @default(2)
  resumeAnalysisLimit     Int   @default(1)
  questionGenerationLimit Int   @default(5)
  coverLetterLimit        Int   @default(0)
  resumeRewriteLimit      Int   @default(0)
  aiEvaluationEnabled     Boolean @default(false)
  // Messages to Ask U, the coach, per IST day (AIIN-100)
  coachMessagesPerDay     Int   @default(10)
  // Talent Match invitations an employer may send per IST calendar month (AIIN-201, AIIN-204); -1 = unlimited
  talentInvitesPerMonth   Int   @default(10)
  prioritySupport         Boolean @default(false)
  
  // Razorpay Plan IDs
  razorpayMonthlyPlanId   String?
  razorpayYearlyPlanId    String?
  
  subscriptions   Subscription[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Subscription {
  id                    String             @id @default(cuid())
  userId                String             @unique
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                String
  plan                  SubscriptionPlan   @relation(fields: [planId], references: [id])
  
  status                SubscriptionStatus @default(ACTIVE)
  billingPeriod         BillingPeriod      @default(MONTHLY)
  
  // Razorpay subscription details
  razorpaySubscriptionId String?           @unique
  razorpayCustomerId     String?
  
  // Billing dates
  currentPeriodStart    DateTime           @default(now())
  currentPeriodEnd      DateTime
  cancelledAt           DateTime?
  
  // Payment history
  payments              Payment[]
  
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  
  @@index([planId])
}

model Payment {
  id                    String       @id @default(cuid())
  subscriptionId        String
  subscription          Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  amount                Int          // Amount in paise
  currency              String       @default("INR")
  status                String       // "captured", "failed", "refunded"
  
  razorpayPaymentId     String?      @unique
  razorpayOrderId       String?
  razorpaySignature     String?
  
  createdAt             DateTime     @default(now())
  
  @@index([subscriptionId])
}

model UsageRecord {
  id              String   @id @default(cuid())
  userId          String
  
  // Usage type
  featureType     String   // "mock_interview", "resume_analysis", "question_generation", "cover_letter", "resume_rewrite"
  
  // Period tracking
  periodStart     DateTime
  periodEnd       DateTime
  usageCount      Int      @default(1)
  
  createdAt       DateTime @default(now())
  
  @@unique([userId, featureType, periodStart])
  @@index([userId, featureType])
}

// Every change to an interview's hiring decision, oldest first (AIIN-157)
model InterviewDecisionEvent {
  id          String         @id @default(cuid())
  interviewId String
  interview   Interview      @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  from        HiringDecision
  to          HiringDecision
  note        String?        @db.Text
  // Null when the system decided, e.g. a drive's auto-shortlist
  byUserId    String?
  byUser      User?          @relation(fields: [byUserId], references: [id], onDelete: SetNull)
  source      DecisionSource @default(MANUAL)
  // Shortlisted after confirming the interview's "Strong concerns" integrity verdict (AIIN-178)
  confirmedConcerns Boolean @default(false)
  createdAt   DateTime       @default(now())

  @@index([interviewId])
}

// One pipeline per job and candidate (AIIN-195). The stage is the candidate's outcome for the job; an AI interview's
// decision moves it (Shortlisted to Screening, Rejected to Rejected), never the other way round.
enum ApplicationStage {
  INVITED
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
  DECLINED
}

enum ApplicationSource {
  INVITED
  DIRECT
}

model Application {
  id              String            @id @default(cuid())
  jobId           String
  job             Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId     String
  candidate       User              @relation("CandidateApplications", fields: [candidateId], references: [id], onDelete: Cascade)
  employerId      String
  employer        User              @relation("EmployerApplications", fields: [employerId], references: [id], onDelete: Cascade)
  source          ApplicationSource @default(INVITED)
  stage           ApplicationStage  @default(APPLIED)
  stageChangedAt  DateTime          @default(now())
  onHold          Boolean           @default(false)
  coverNote       String?
  rejectionReason String?
  // A Talent Match invitation (AIIN-201): the employer's message, when it was sent, when it lapses
  inviteMessage   String?
  invitedAt       DateTime?
  inviteExpiresAt DateTime?
  // When the candidate last looked at My applications, for "Updated" (AIIN-197)
  candidateSeenAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  events          ApplicationEvent[]
  humanRounds     HumanRound[]

  @@unique([jobId, candidateId])
  @@index([employerId, stage])
  @@index([jobId, stage])
  @@index([candidateId])
}

// Every move and note on an application, for its history (AIIN-195)
model ApplicationEvent {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorId       String?
  actor         User?             @relation("ApplicationEvents", fields: [actorId], references: [id], onDelete: SetNull)
  fromStage     ApplicationStage?
  toStage       ApplicationStage?
  note          String?
  createdAt     DateTime          @default(now())

  @@index([applicationId, createdAt])
}

// An employer a candidate never wants to see or invite them (AIIN-198)
model CandidateBlock {
  candidateId String
  candidate   User     @relation("BlockedBy", fields: [candidateId], references: [id], onDelete: Cascade)
  employerId  String
  employer    User     @relation("BlockedEmployer", fields: [employerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([candidateId, employerId])
  @@index([employerId])
}

// A candidate's match for a job (AIIN-199): deterministic score and parts, reasons, and which scorer made it.
model JobMatch {
  id                 String           @id @default(cuid())
  jobId              String
  job                Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  employerId         String
  score              Int
  parts              Json
  reasons            String[]
  scorerVersion      Int
  computedAt         DateTime         @default(now())

  @@unique([jobId, candidateProfileId])
  @@index([jobId, score])
  @@index([employerId])
}

// Match work still to do (AIIN-199): run right after the change that queued it, and retried by the daily cron.
model MatchTask {
  id        String    @id @default(cuid())
  kind      String // JOB or PROFILE
  targetId  String
  attempts  Int       @default(0)
  lockedAt  DateTime?
  createdAt DateTime  @default(now())

  @@unique([kind, targetId])
}

// A human interview round under an application (AIIN-196): recorded, with a calendar invite; no built-in video
// (AIIN-204). AI rounds stay as Interview rows for the same job and candidate, so scores and rankings are untouched.
enum RoundOutcome {
  PASSED
  FAILED
  NO_SHOW
}

model HumanRound {
  id            String        @id @default(cuid())
  applicationId String
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  roundName     String
  startsAt      DateTime
  durationMins  Int           @default(45)
  interviewer   String?
  meetingLink   String
  // Bumped on every change, so calendars replace the old invite (RFC 5545 SEQUENCE)
  sequence      Int           @default(0)
  outcome       RoundOutcome?
  cancelledAt   DateTime?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([applicationId, startsAt])
}

// ---- Hiring drives (AIIN-165) ----
// A campus or bulk hiring round for one job. Its status is worked out from the dates (lib/drives.ts), never stored:
// Draft until saved with dates, Scheduled before opensAt, Live until closesAt, Closed after it or once closedAt is set.
model Drive {
  id              String    @id @default(cuid())
  jobId           String
  job             Job       @relation(fields: [jobId], references: [id])
  employerId      String
  name            String
  draft           Boolean   @default(true)
  opensAt         DateTime?
  closesAt        DateTime?
  closedAt        DateTime? // closed early by the employer; cleared on reopen (within 7 days)
  interviewCutoff Float? // 0–10; required when autoShortlist is on
  autoShortlist   Boolean   @default(false)
  // Optional aptitude round before the AI interview (AIIN-169): pass at or above aptitudeCutoff percent
  aptitudeEnabled Boolean       @default(false)
  aptitudeTestId  String?
  aptitudeTest    AptitudeTest? @relation(fields: [aptitudeTestId], references: [id])
  aptitudeCutoff  Int?
  // One open link for students to join themselves (AIIN-168): /drive/<openLinkSlug>
  openLinkSlug    String?       @unique
  openLinkOn      Boolean       @default(false)
  allowedDomains  String[]      @default([])
  joinCap         Int?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  colleges   DriveCollege[]
  candidates DriveCandidate[]
  interviews Interview[]

  @@index([employerId])
  @@index([jobId])
}

model DriveCollege {
  id                    String   @id @default(cuid())
  driveId               String
  drive                 Drive    @relation(fields: [driveId], references: [id], onDelete: Cascade)
  name                  String
  city                  String?
  placementOfficerEmail String?
  createdAt             DateTime @default(now())

  candidates DriveCandidate[]

  @@index([driveId])
}

enum DriveStage {
  INVITED
  OPENED
  APTITUDE_STARTED
  APTITUDE_PASSED
  APTITUDE_FAILED
  INTERVIEW_STARTED
  INTERVIEW_FINISHED
}

enum DriveSource {
  CSV
  OPEN_LINK
  MANUAL
}

model DriveCandidate {
  id             String        @id @default(cuid())
  driveId        String
  drive          Drive         @relation(fields: [driveId], references: [id], onDelete: Cascade)
  driveCollegeId String?
  college        DriveCollege? @relation(fields: [driveCollegeId], references: [id], onDelete: SetNull)
  userId         String
  interviewId    String?       @unique
  stage          DriveStage    @default(INVITED)
  rollNumber     String?
  attempt        AptitudeAttempt?
  source         DriveSource
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([driveId, userId])
  @@index([driveId, stage])
  @@index([driveCollegeId])
}

// ---- Email outbox (AIIN-167) ----
// Emails are queued here and sent by a worker in batches, with retries; never inside a user's request.
// See docs/architecture/2026-11-13-queue-outbound-email-in-the-database.md.
enum OutboundStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  BOUNCED
}

model OutboundEmail {
  id               String         @id @default(cuid())
  to               String
  template         String // e.g. DRIVE_INVITE, DRIVE_REMINDER
  payload          Json // what the template needs; rendered at send time
  driveId          String?
  driveCandidateId String?
  interviewId      String?
  // One email per purpose: e.g. "DRIVE_REMINDER:<driveCandidateId>", so a reminder is never queued twice
  dedupeKey        String?        @unique
  status           OutboundStatus @default(QUEUED)
  attempts         Int            @default(0)
  lastError        String?
  sendAfter        DateTime       @default(now())
  sentAt           DateTime?
  providerId       String?        @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status, sendAfter])
  @@index([driveId, status])
  @@index([driveCandidateId])
}

// ---- Aptitude round (AIIN-169; employer-built tests in AIIN-226) ----
// A test has named sections; each attempt draws askCount checked questions from every section's pool.
model AptitudeTest {
  id              String    @id @default(cuid())
  name            String
  durationMinutes Int
  ownerId         String? // null: a ready-made test written by us; otherwise the employer who owns it
  shuffle         Boolean   @default(true) // shuffle each question's options per attempt
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sections  AptitudeSection[]
  questions AptitudeQuestion[]
  drives    Drive[]
  attempts  AptitudeAttempt[]

  @@index([ownerId])
}

model AptitudeSection {
  id        String       @id @default(cuid())
  testId    String
  test      AptitudeTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  name      String
  askCount  Int
  order     Int          @default(0)

  questions AptitudeQuestion[]

  @@index([testId])
}

model AptitudeQuestion {
  id           String          @id @default(cuid())
  testId       String
  test         AptitudeTest    @relation(fields: [testId], references: [id], onDelete: Cascade)
  sectionId    String
  section      AptitudeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  text         String
  options      String[]
  correctIndex Int // never sent to a candidate's browser
  explanation  String?
  checked      Boolean         @default(false) // only checked questions are used in attempts
  retiredAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([testId, sectionId])
}

// The server owns time and scoring: the deadline is set on start and answers count only up to it (plus 30 s grace).
model AptitudeAttempt {
  id               String         @id @default(cuid())
  driveCandidateId String         @unique
  driveCandidate   DriveCandidate @relation(fields: [driveCandidateId], references: [id], onDelete: Cascade)
  testId           String
  test             AptitudeTest   @relation(fields: [testId], references: [id])
  questionIds      String[] // the drawn questions, in the order shown
  optionOrders     Json // per question: the order its options are shown in (indexes into options)
  answers          Json           @default("{}") // questionId → original option index
  startedAt        DateTime       @default(now())
  deadline         DateTime
  submittedAt      DateTime?
  score            Int?
  total            Int?
  percent          Float?
  passed           Boolean?
  tabSwitches      Int            @default(0) // times the candidate left the tab, for the employer
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([testId])
  @@index([deadline])
}
